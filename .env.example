# Environment variables
#
# Sections:
# - Supabase
# - Stripe
# - DocuSign

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# DocuSign
DOCUSIGN_CLIENT_ID=your-docusign-client-id
DOCUSIGN_USER_ID=your-docusign-user-id
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEAyour-placeholder-private-key
replace-this-with-your-docusign-rsa-private-key
-----END RSA PRIVATE KEY-----"
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
